<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CBTPRDM_TP03.ViewModels"
             x:Class="CBTPRDM_TP03.Views.HomePage"
             x:DataType="vm:TrackingViewModel"
             Title="Rastreamento Logístico">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Rastreie seu pacote"
                   FontSize="26"
                   FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />

            <Label Text="Digite o código de rastreamento para ver o status da sua encomenda."
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

            <!-- Entrada do código; o Enter do teclado também dispara a busca -->
            <Entry Placeholder="Ex.: LGX-48215"
                   Text="{Binding TrackingCode}"
                   ReturnType="Search"
                   ReturnCommand="{Binding SearchCommand}"
                   Keyboard="Plain"
                   ClearButtonVisibility="WhileEditing"
                   SemanticProperties.Hint="Código de rastreamento do pacote" />

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="#C62828"
                   FontSize="13" />

            <Button Text="Rastrear pacote"
                    Command="{Binding SearchCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

            <!-- Códigos de teste (dados fictícios) -->
            <Border StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    StrokeShape="RoundRectangle 10"
                    Padding="14"
                    Margin="0,12,0,0">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Códigos para teste" FontAttributes="Bold" FontSize="14" />
                    <Label Text="LGX-48215 — Em rota" FontSize="13" />
                    <Label Text="TRK-90317 — Entregue" FontSize="13" />
                    <Label Text="MVP-27064 — Coletado" FontSize="13" />
                    <Label Text="ENT-55102 — Entrega não realizada" FontSize="13" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
